# TaskBoard
TASKBOARD_URL=http://localhost:5005
TASKBOARD_TOKEN=dev-token

# Workspace: all changes happen in this folder (no clone). One task at a time.
WORKSPACE_PATH=/Users/vishwakapoor/Documents/Code/GitHub/factory-workspace-1

# LM Studio (local LLM). Use this so LangGraph actually generates code.
LMSTUDIO_BASE_URL=http://192.168.1.254:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b

# Skip PR and push — just run Execute -> Tests -> Close. Changes stay in WORKSPACE_PATH.
SKIP_PR=1

# Optional: Temporal
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_TASK_QUEUE=dark-factory
