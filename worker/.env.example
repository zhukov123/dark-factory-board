# TaskBoard
TASKBOARD_URL=http://localhost:5005
TASKBOARD_TOKEN=dev-token

# Workspace: all changes happen in this folder (no clone). One task at a time.
WORKSPACE_PATH=/Users/vishwakapoor/Documents/Code/GitHub/factory-workspace-1

# OpenRouter (default). Set OPENROUTER_API_KEY; default model is minimax/minimax-m2.5.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=minimax/minimax-m2.5

# LM Studio (local LLM). Used when OPENROUTER_API_KEY is not set.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local

# Optional: Temporal
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_TASK_QUEUE=dark-factory
