# Copy to .env.e2e and fill in values. .env.e2e is gitignored and never committed.
# E2E run: source .env.e2e before starting worker/containers (e.g. set -a && source .env.e2e && set +a).
# OPENROUTER_API_KEY=sk-or-v1-...
# GITEA_URL=           # set by bootstrap script
# GITEA_TOKEN=         # set by bootstrap script
# WORKSPACE_REPO=      # set by bootstrap script
# TASKBOARD_URL=http://localhost:5005
# TASKBOARD_TOKEN=dev-token
